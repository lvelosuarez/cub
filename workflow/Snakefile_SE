def notify(run, status, message=""):
    """Central point for run status events. Logs now; will also send email later."""
    full_status = f"{status}: {message}" if message else status
    log_master(run, full_status)
    if status in EMAIL_ON:
        try:
            subprocess.run(["python", MAILER, "[cub] {}: {}".format(run, status), full_status, MAIL_TO], check=False)
        except Exception:
            pass


def get_eligible_runs(nas_dir):
    """Folders with RTAComplete.txt and no Snakemake_complete.txt"""
    eligible = []
    for entry in os.listdir(nas_dir):
        run_path = os.path.join(nas_dir, entry)
        if not os.path.isdir(run_path):
            continue
        has_rta  = os.path.exists(os.path.join(run_path, "RTAComplete.txt"))
        has_done = os.path.exists(os.path.join(run_path, "Snakemake_complete.txt"))
        if has_rta and not has_done:
            eligible.append(entry)
    return eligible

# copy from nas to san
def log_line(run, message):
    """Append a timestamped line to this run's pipeline.log on the SAN"""
    log_path = os.path.join(SAN_DIR, run, "pipeline.log")
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    with open(log_path, "a") as f:
        f.write(f"{pd.Timestamp.now()} | {message}\n")

def log_master(run, status):
    """Append one summary line per run to the global SAN log"""
    master_path = os.path.join(SAN_DIR, "cron_master.log")
    with open(master_path, "a") as f:
        f.write(f"{pd.Timestamp.now()} | run={run} | status={status}\n")
        
def run_bcl2fastq(run):
    """Generate fastq_out/ from raw BCL data for one run."""
    run_dir = os.path.join(NAS_DIR, run)
    out_dir = os.path.join(run_dir, "fastq_out")
    sample_sheet = os.path.join(run_dir, "SampleSheet.csv")
    stats_marker = os.path.join(out_dir, "Stats", "Stats.json")

    if os.path.isfile(stats_marker):
        log_line(run, f"bcl2fastq skipped, completed run already found at {stats_marker}")
        return
    
    log_line(run, "bcl2fastq started")
    result = subprocess.run(
        [
            "/mnt/san/microbio/conda/bcl2fastq",
            "--runfolder-dir", run_dir,
            "--output-dir", out_dir,
            "--sample-sheet", sample_sheet,
            "--no-lane-splitting",
            "--barcode-mismatches", "1",
            "--loading-threads", "4",
            "--processing-threads", str(os.cpu_count()),
            "--writing-threads", "12",
        ],
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        log_line(run, f"bcl2fastq FAILED (exit {result.returncode}): {result.stderr[-2000:]}")
        raise RuntimeError(f"bcl2fastq failed for {run} (exit {result.returncode})")

    log_line(run, "bcl2fastq finished")

    
def stage_run(run):
    """rsync fastq_out/ and SampleSheet.csv from NAS to SAN for one run"""
    nas_run = os.path.join(NAS_DIR, run)
    san_run = os.path.join(SAN_DIR, run)
    os.makedirs(san_run, exist_ok=True)

    log_line(run, "staging started")

    r1 = subprocess.run(
        ["rsync", "-avh", f"{nas_run}/fastq_out/", f"{san_run}/fastq_out/"],
        capture_output=True, text=True,
    )
    if r1.returncode != 0:
        log_line(run, f"rsync fastq_out FAILED (exit {r1.returncode}): {r1.stderr[-2000:]}")
        raise RuntimeError(f"rsync fastq_out failed for {run}")

    r2 = subprocess.run(
        ["rsync", "-avh", f"{nas_run}/SampleSheet.csv", f"{san_run}/SampleSheet.csv"],
        capture_output=True, text=True,
    )
    if r2.returncode != 0:
        log_line(run, f"rsync SampleSheet.csv FAILED (exit {r2.returncode}): {r2.stderr[-2000:]}")
        raise RuntimeError(f"rsync SampleSheet.csv failed for {run}")

    log_line(run, "staging finished")

