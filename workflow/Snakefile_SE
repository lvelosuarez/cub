rule qc:
     input:
         unpack(lambda wildcards: get_raw_fastq(wildcards.names))
     output:
         r1 = "output/qc/{names}_R1.fastq.gz",
     log:
         "output/qc/{names}_bbduk.log"
     params:
         sex_kmers = "/mnt/san/microbio/apps/cub/resources/sex_chromosome_kmers.fasta"
     shell:
         """
         bbduk.sh -Xmx16g \
           in={input.r1} \
           ref=adapters,artifacts,phix,lambda,pjet,mtst,kapa \
           out={output.r1}.tmp.fastq.gz \
           qtrim=rl trimq=20 maq=20 minlen=50 \
           entropy=0.5 entropywindow=50 \
           2> {log}
         bbduk.sh -Xmx16g \
           in={output.r1}.tmp.fastq.gz \
           ref={params.sex_kmers} \
           out={output.r1} \
           k=31 \
           2>> {log}
         rm {output.r1}.tmp.fastq.gz
         """

rule dedup:
    input:
        r1 = "output/qc/{names}_R1.fastq.gz",
    output:
        r1 = "output/dedup/{names}_dedup_R1.fastq.gz",
    log:
        "output/qc/{names}_dedup.log",
    shell:
        """
        clumpify.sh -Xmx16g \
          in={input.r1} \
          out={output.r1} \
          dedupe=t qin=33 interleaved=f \
          &> {log}
        """


rule dehost:
    input:
        r1 = "output/dedup/{names}_dedup_R1.fastq.gz",
    output:
        r1 = "output/dehost/{names}_dedup_R1.clean.fastq.gz",
    threads: 10
    params:
        index_path = config["hostile_index"]
    shell:
        """
        hostile clean \
          --fastq1 {input.r1} \
          --index {params.index_path} \
          --aligner bowtie2 --airplane \
          -o output/dehost/ --threads {threads} --force
        """


